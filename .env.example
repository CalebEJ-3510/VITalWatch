# VITalWatch synthetic prototype only — never load identifiable clinical records.
# Real per-user login and enforced role-based access control (see app/auth.py) —
# every mutating route requires a session whose role is permitted, and the audit
# trail's "actor" field is now a real username rather than a fixed demo string.
APP_MODE=demo
DEMO_SEED_ENABLED=true
# HTTPS is required by default. Only allow HTTP for local loopback development.
DEMO_ALLOW_HTTP=false
CLINICAL_TIMEZONE=Asia/Kolkata
SEED_TRIALS=8
SEED_RANDOM_SEED=20260822

# --- Authentication -------------------------------------------------------------
# APP_SECRET signs the CSRF token. It MUST be a unique random string (32+ chars)
# in any environment that is not a developer's own machine — the value below is
# the recognisable, insecure default the app ships with when this is unset.
# APP_SECRET=change-me-to-a-random-32-plus-character-string
SESSION_TTL_HOURS=12

# Five demo accounts, one per role (app/models.py::UserRole), are created on
# first seed (app/datagen.py, DEMO_USERS) so every dashboard and every write
# route can be exercised end to end. Fixed on purpose so the demo script and
# rehearsal harness can name them; the sign-in page offers them as one-click
# quick-fill chips. ROTATE OR REMOVE THEM before any deployment that is not a
# disposable demo:
#   volunteer.demo / CtmsVolunteer#01     volunteer
#   company.demo / AiiaCompany#01         company
#   investigator.demo / AiiaTrialLead#01  investigator
#   safety.demo / AiiaSafety#01           safety_officer
#   leadership.demo / AiiaLeadership#01   leadership

APP_NAME=VITalWatch
ORG_NAME="All India Institute of Ayurveda — NPvCC"

# --- Database -----------------------------------------------------------------
# Unset: the app runs on a local SQLite file (data/ctms.db) and needs no network.
# Set:   every query runs against Postgres instead. Supabase gives you this string
#        under Project Settings -> Database -> Connection string -> URI.
#
# Use a POOLER host. The direct connection (db.<ref>.supabase.co) is IPv6-only and
# unreachable from most home networks and from Render's free tier. The pooler host
# looks like aws-0-<region>.pooler.supabase.com and the username carries the project
# ref after a dot:
#
# DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
#
# Port 5432 is the session pooler and 6543 the transaction pooler; both work, because
# server-side prepared statements are disabled in app/db.py for exactly this reason.
# sslmode=require is added automatically if the URL does not already carry it.
DB_POOL_MAX=5
DB_CONNECT_TIMEOUT=10

# Alert thresholds — change one and refresh to prove they are configurable.
ENROLMENT_LAG_PCT=80
ETHICS_RENEWAL_DAYS=60
MONITORING_OVERDUE_DAYS=14

# Statutory clocks, New Drugs and Clinical Trials Rules 2019.
SAE_INITIAL_REPORT_HOURS=24
SAE_NARRATIVE_DAYS=14
SAE_DUE_SOON_HOURS=6

# Governance escalation clock (spec section 14) — separate from the SAE reporting
# clocks above. Currently defined but not yet read by any route; tracked in
# docs/implementation-roadmap.md Phase 5. Configurable per applicable regulatory
# framework rather than hard-coded, per the spec's explicit requirement.
STATUTORY_CLOCK_HOURS=72
STATUTORY_CLOCK_DUE_SOON_HOURS=12

# SQLite file path (ignored when DATABASE_URL is set).
DB_PATH=data/ctms.db
